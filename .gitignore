# Ignore all
*
# Unignore all with extensions
!*.*
# Unignore all dirs
!*/
### Above combination will ignore all files without extension ###

# Allow Makefile
!Makefile
!dconfig

# Ignore files with certain extension
*.swp
*.pyc
*.txt

# Ignore build, devel, and logs folder
__pycache__
.vscode
data
features
checkpoints
outputs
